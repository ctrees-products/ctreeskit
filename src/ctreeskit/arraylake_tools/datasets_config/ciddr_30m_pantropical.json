                    "20": "Regrowth Forest gain current",
                    "21": "Regrowth Forest past",
                    "22": "Regrowth Forest loss current",
                    "23": "Regrowth Forest loss past",
                    "30": "Degraded Regrowth current",
                    "31": "Degraded Regrowth past",
                    "32": "Degraded Regrowth loss current",
                    "34": "Repeated Degraded Regrowth current",
                    "40": "Forest Plantation current",
                    "41": "Forest Plantation past",
